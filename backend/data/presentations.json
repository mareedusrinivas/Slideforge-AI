            }
          },
          {
            "id": "34f833d3-9eca-48e9-8655-861716049485",
            "type": "text",
            "x": 160,
            "y": 260,
            "width": 720,
            "height": 640,
            "content": "• Technical Hurdles\n\n• Mitigating model hallucinations and factual inaccuracies\n\n• Managing high inference costs and latency constraints\n\n• Handling domain-specific jargon and rare terminology",
            "style": {
              "fontFamily": "Inter",
              "fontSize": 26,
              "fontWeight": 400,
              "color": "#292524",
              "lineHeight": 1.8
            }
          },
          {
            "id": "c4d0216c-b2e7-4831-8111-6d0aef909ea3",
            "type": "shape",
            "x": 1000,
            "y": 220,
