              "borderWidth": 1,
              "borderRadius": 20
            }
          },
          {
            "id": "d55ccbbb-b3f3-4b54-98fc-94dad64d3d94",
            "type": "text",
            "x": 1040,
            "y": 260,
            "width": 720,
            "height": 640,
            "content": "• Deep learning and massive transformer models\n\n• Automated feature discovery via self-supervision\n\n• Superior context handling and memory retention\n\n• High adaptability across diverse industry verticals",
            "style": {
              "fontFamily": "Inter",
              "fontSize": 26,
              "fontWeight": 400,
              "color": "#f8fafc",
              "lineHeight": 1.8
            }
          }
