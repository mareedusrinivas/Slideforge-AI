              "borderRadius": 20
            }
          },
          {
            "id": "17328378-0b68-41bd-ac83-547727be66a9",
            "type": "text",
            "x": 1040,
            "y": 260,
            "width": 720,
            "height": 640,
            "content": "• Governance & Ethics\n\n• Ensuring data privacy and compliance (GDPR, HIPAA)\n\n• Detecting and reducing inherent algorithmic bias\n\n• Maintaining transparent and auditable decision trails",
            "style": {
              "fontFamily": "Inter",
              "fontSize": 26,
              "fontWeight": 400,
              "color": "#292524",
              "lineHeight": 1.8
            }
          }
