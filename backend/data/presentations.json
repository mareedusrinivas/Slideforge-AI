              "textAlign": "center"
            }
          },
          {
            "id": "a6fccd34-da1e-48b8-afb5-ae8e34bdce7c",
            "type": "text",
            "x": 200,
            "y": 490,
            "width": 1520,
            "height": 100,
            "content": "Bridging human communication and computational intelligence",
            "style": {
              "fontFamily": "Inter",
              "fontSize": 30,
              "fontWeight": 400,
              "color": "#a1a1aa",
              "textAlign": "center"
