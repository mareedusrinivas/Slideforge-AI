          "value": "#0d0a1b",
          "opacity": 1
        },
        "notes": "Welcome everyone. Today we are exploring Natural Language Processing, a transformative technology that allows machines to understand, interpret, and generate human language.",
        "elements": [
          {
            "id": "dc21d912-4a5c-4684-98f3-59c023d29639",
            "type": "heading",
            "x": 160,
            "y": 280,
            "width": 1600,
            "height": 180,
            "content": "Natural Language Processing",
            "style": {
              "fontFamily": "Outfit",
              "fontSize": 64,
