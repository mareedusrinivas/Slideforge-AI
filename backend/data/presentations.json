            "height": 90,
            "content": "Navigating Implementation Challenges",
            "style": {
              "fontFamily": "Playfair Display",
              "fontSize": 48,
              "fontWeight": 700,
              "color": "#292524",
              "textAlign": "left"
            }
          },
          {
            "id": "c748a244-de58-4dab-bc2b-2197c813318a",
            "type": "shape",
            "x": 120,
